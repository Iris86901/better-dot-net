# Dot-Proxy Local Configuration Template
# Copy this file to `.env.local` (git-ignored) and fill in your own values.
# NEVER commit `.env` or `.env.local` to Git.

# --- Public Domain & Access Control ---
DOT_PROXY_DOMAIN=proxy.example.com
BASE_URL=https://proxy.example.com
ACCESS_KEY=replace-with-strong-random-key

# --- Gateway & meow-rs Runtime ---
HOST=127.0.0.1
PORT=3030
STATE_DIR=/var/lib/dot-proxy
MEOW_BIN=/opt/dot-proxy/bin/meow
MEOW_SOCKS=127.0.0.1:17890
MEOW_API=127.0.0.1:19090
# Leave empty on first deploy to auto-generate a random secret in /etc/dot-proxy/env
MEOW_SECRET=
# Optional default upstream proxy/VPN URI (can also be configured live in the Home UI)
# UPSTREAM_PROXY=socks5h://user:pass@host:port

# --- Local Build & Deployment (Optional) ---
# SSH host alias or user@host for deploy/push-deploy.ps1
VPS_SSH_HOST=my-vps
# Optional remote source mirror directory and owner
# SYNC_SRC_DIR=/home/user/dot-proxy
# SYNC_SRC_OWNER=user:user
# Optional extra systemd service names (space-separated) to display in deploy status
# EXTRA_CHECK_SERVICES=

# --- Local E2E Browser Verification (Optional) ---
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
